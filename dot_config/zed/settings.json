// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    }
  },
  "languages": {
    "Go": {
      "format_on_save": "on",
      "soft_wrap": "editor_width",
      "formatter": "auto",
    },
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "format_on_save": "off",
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "icon_theme": "Material Icon Theme",
  "private_files": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/*.cert",
    "**/*.crt",
    "**/secrets.yml",
  ],
  "session": {
    "trust_all_worktrees": true,
  },
  "use_smartcase_search": true,
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "which_key": {
    "enabled": true,
  },
  "title_bar": {
    "show_branch_icon": true,
    "show_branch_name": true,
    "show_project_items": true,
    "show_onboarding_banner": true,
    "show_user_picture": true,
    "show_user_menu": true,
    "show_sign_in": true,
  },
  "toolbar": {
    "code_actions": true,
  },
  "always_treat_brackets_as_autoclosed": true,
  "show_signature_help_after_edits": true,
  "auto_signature_help": true,
  "edit_predictions": {
    "sweep": {
      "privacy_mode": false,
    },
    "mode": "eager",
  },
  "ui_font_family": "JetBrains Mono",
  "buffer_line_height": {
    "custom": 2.5,
  },
  "buffer_font_weight": 400.0,
  "buffer_font_family": "JetBrains Mono",
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow",
        },
      },
    },
    "default_profile": "yolo",
    "default_model": {
      "effort": "high",
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
      "enable_thinking": true,
    },
    "profiles": {
      "yolo": {
        "name": "yolo",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {},
      },
    },
    "model_parameters": [],
  },
  "terminal": {
    "shell": {
      "program": "fish",
    },
    "font_family": "MesloLGS NF",
    "font_size": 14.0,
    "line_height": "comfortable",
  },
  "relative_line_numbers": "enabled",
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "settings": {
        "context7_api_key": "ctx7sk-84d44478-f981-4b0c-9c58-7a5dfcb4b369",
      },
    },
  },
  "base_keymap": "VSCode",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "vim_mode": true,
  "ui_font_size": 14,
  "buffer_font_size": 12.0,
  "theme": "Fleet Dark",
}
