#!/bin/sh
set -eu

fish_path="/usr/bin/fish"

if [ ! -x "$fish_path" ]; then
  echo "Fish is not installed; leaving the login shell unchanged." >&2
  exit 0
fi

if ! grep -qx "$fish_path" /etc/shells; then
  echo "$fish_path is not an approved login shell; leaving the login shell unchanged." >&2
  exit 0
fi

current_shell="$(getent passwd "$USER" | cut -d: -f7)"
if [ "$current_shell" != "$fish_path" ]; then
  chsh -s "$fish_path" "$USER"
fi
